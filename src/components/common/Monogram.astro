---
import { cn } from "@/lib/utils";

/** The FI monogram, same artwork as public/favicon.svg. Decorative: always sits next to the name. */
const { class: className } = Astro.props as { class?: string };
---

<svg viewBox="0 0 64 64" aria-hidden="true" focusable="false" class={cn("shrink-0", className)}>
  <rect x="1" y="1" width="62" height="62" rx="14" fill="#161A27" stroke="#2A3145" stroke-width="2"></rect>
  <path d="M19.5 48V19.5H37M19.5 33H33" stroke="#E8EAF0" stroke-width="7" fill="none"></path>
  <rect x="41" y="16" width="7" height="32" fill="#7C95FF"></rect>
</svg>
