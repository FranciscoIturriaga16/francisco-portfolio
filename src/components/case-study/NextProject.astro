---
import { ArrowRight } from "@lucide/astro";
import Eyebrow from "@/components/common/Eyebrow.astro";
import { cardSurface } from "@/components/common/styles";
import type { Project } from "@/content/projects";
import { cn } from "@/lib/utils";

const { project } = Astro.props as { project: Project };
---

<a
  href={`/case-study/${project.id}`}
  class={cn(
    cardSurface,
    "group mt-[140px] flex flex-wrap items-center justify-between gap-6 rounded-3xl p-10 text-foreground transition-colors hover:border-border-strong focus-visible:border-border-strong",
  )}
>
  <div class="min-w-0">
    <Eyebrow tone="label" size="sm">Next project</Eyebrow>
    <p class="mt-2 text-[clamp(32px,4vw,48px)] font-bold leading-[1.1] tracking-[-0.03em]">{project.title}</p>
    <p class="mt-1.5 text-base text-muted">{project.summary}</p>
  </div>
  <span
    aria-hidden="true"
    class="inline-flex size-14 shrink-0 items-center justify-center rounded-full bg-accent text-background transition-transform group-hover:translate-x-1 group-focus-visible:translate-x-1"
  >
    <ArrowRight class="size-[22px]" stroke-width={2.2} />
  </span>
</a>
