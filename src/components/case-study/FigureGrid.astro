---
import DeviceFrame from "@/components/common/DeviceFrame.astro";
import type { Figure } from "@/content/caseStudies";

const frameSize = {
  phone: "h-[360px] w-[240px] max-w-full rounded-[28px]",
  screen: "max-h-[360px] w-full",
  plain: "h-full w-full",
};

/** Captioned screenshots shown below a section. Always below the fold, so images load lazily. */
const { figures } = Astro.props as { figures: Figure[] };

// One figure spans the full width; two or more share a row on wide screens.
const sizes =
  figures.length === 1
    ? "(min-width: 1120px) 1024px, calc(100vw - 96px)"
    : "(min-width: 1120px) 476px, (min-width: 696px) calc(50vw - 72px), calc(100vw - 96px)";
---

<div class="grid grid-cols-[repeat(auto-fit,minmax(min(300px,100%),1fr))] gap-6 pt-[var(--space-block-figures)]">
  {
    figures.map((figure) => (
      <figure>
        <div class="flex h-[420px] items-center justify-center overflow-hidden rounded-[20px] border border-border bg-surface p-6">
          <DeviceFrame
            image={figure.image}
            widths={figure.image.frame === "phone" ? [240, 480] : [480, 800, 1200]}
            sizes={figure.image.frame === "phone" ? "240px" : sizes}
            class={frameSize[figure.image.frame]}
          />
        </div>
        <figcaption class="mt-3 text-[15px] text-label">
          <span class="font-medium text-foreground">{figure.captionTitle}</span> {figure.caption}
        </figcaption>
      </figure>
    ))
  }
</div>
