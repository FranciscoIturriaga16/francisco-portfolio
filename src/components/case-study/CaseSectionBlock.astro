---
import { ArrowDown, ArrowLeft, ArrowRight, ArrowUp, Check, Quote, Repeat } from "@lucide/astro";
import Eyebrow from "@/components/common/Eyebrow.astro";
import type { CaseSection } from "@/content/caseStudies";
import { cn } from "@/lib/utils";
import FigureGrid from "./FigureGrid.astro";

interface Props {
  number: string;
  section: CaseSection;
}

const letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";

/**
 * Grid cells for a four step loop, clockwise from the top left, and the arrow that leaves each step.
 * Below 640 px the loop is a vertical stack instead: down arrows between steps, then a repeat icon.
 */
const cycleLayout = [
  { step: "col-start-1 row-start-1", arrow: "col-start-2 row-start-1", Icon: ArrowRight },
  { step: "col-start-3 row-start-1", arrow: "col-start-3 row-start-2", Icon: ArrowDown },
  { step: "col-start-3 row-start-3", arrow: "col-start-2 row-start-3", Icon: ArrowLeft },
  { step: "col-start-1 row-start-3", arrow: "col-start-1 row-start-2", Icon: ArrowUp },
];

const pad = (value: number) => String(value).padStart(2, "0");

/** One numbered case study section: label column on the left, content on the right (stacked on small screens). */
const { number, section } = Astro.props;
const { id, title, comparison } = section;
const headingId = `${id}-title`;
const cycle = section.cycle?.slice(0, cycleLayout.length);
---

<section id={id} aria-labelledby={headingId} class="flex flex-wrap gap-x-16 gap-y-6 pt-[var(--space-section-case)]">
  <div class="shrink grow basis-[220px]">
    <p class="font-mono text-[13px] text-accent">{number}</p>
    <h2 id={headingId} class="mt-2 text-[32px] font-semibold leading-[1.15] tracking-[-0.02em]">
      {title}
    </h2>
  </div>

  <div class="min-w-0 shrink grow-[999] basis-[560px] [&>*:first-child]:mt-0">
    {section.lead && <p class="text-[22px] leading-[1.5] tracking-[-0.01em]">{section.lead}</p>}

    {section.body?.map((paragraph) => <p class="mt-5 text-muted">{paragraph}</p>)}

    {
      section.points && (
        <dl class="mt-8 flex flex-col gap-px overflow-hidden rounded-2xl border border-border bg-border">
          {section.points.map((point) => (
            <div class="flex flex-wrap gap-x-8 gap-y-2 bg-panel px-7 py-6">
              <dt class="shrink-0 basis-[120px] pt-0.5 font-mono text-[13px] uppercase tracking-[0.08em] text-accent">
                {point.term}
              </dt>
              <dd class="min-w-0 flex-1 basis-[280px] text-base text-muted">{point.text}</dd>
            </div>
          ))}
        </dl>
      )
    }

    {
      section.flows?.map((flow) => (
        <div class="mt-8 rounded-2xl border border-border bg-surface p-6 sm:p-7">
          <Eyebrow as="h3" tone="label" size="sm">
            {flow.label}
          </Eyebrow>
          <ol class="mt-4 grid gap-10 sm:grid-cols-2">
            {flow.steps.map((step, index) => (
              <li class="relative rounded-xl border border-border bg-panel p-5">
                {index > 0 && (
                  <span
                    aria-hidden="true"
                    class="absolute -top-[30px] left-1/2 -translate-x-1/2 text-accent sm:-left-[30px] sm:top-1/2 sm:-translate-y-1/2 sm:translate-x-0"
                  >
                    <ArrowDown class="size-5 sm:hidden" stroke-width={2.2} />
                    <ArrowRight class="hidden size-5 sm:block" stroke-width={2.2} />
                  </span>
                )}
                <p class="font-mono text-[13px] text-accent">{pad(index + 1)}</p>
                <h4 class="mt-1 font-semibold">{step.title}</h4>
                <p class="mt-1.5 text-base text-muted">{step.text}</p>
              </li>
            ))}
          </ol>
        </div>
      ))
    }

    {
      cycle && (
        <div
          role="list"
          aria-label="A loop: the last step leads back to the first"
          class="mt-10 flex flex-col gap-3 rounded-2xl border border-border bg-surface p-4 sm:grid sm:grid-cols-[1fr_auto_1fr] sm:grid-rows-[1fr_auto_1fr] sm:gap-4 sm:p-7"
        >
          {cycle.map((step, index) => {
            const { step: stepCell, arrow: arrowCell, Icon } = cycleLayout[index]!;
            const last = index === cycle.length - 1;
            return (
              <>
                <div role="listitem" class={cn(stepCell, "rounded-xl border border-border bg-panel p-4 sm:p-5")}>
                  <p class="font-mono text-[13px] text-accent">{pad(index + 1)}</p>
                  <p class="mt-1 text-[15px] font-medium leading-snug sm:text-base">{step}</p>
                </div>
                <span aria-hidden="true" class={cn(arrowCell, "flex justify-center sm:place-self-center")}>
                  {last ? (
                    <Repeat class="size-5 text-label sm:hidden" />
                  ) : (
                    <ArrowDown class="size-5 text-accent sm:hidden" stroke-width={2.2} />
                  )}
                  <Icon class="hidden size-5 text-accent sm:block" stroke-width={2.2} />
                </span>
              </>
            );
          })}
          <Repeat aria-hidden="true" class="col-start-2 row-start-2 hidden size-5 place-self-center text-label sm:block" />
        </div>
      )
    }

    {
      section.stats && (
        <ul class="mt-8 grid gap-4 sm:grid-cols-3">
          {section.stats.map((stat) => (
            <li class="rounded-2xl border border-border bg-surface p-6">
              <p class="text-[clamp(22px,2.4vw,28px)] font-semibold leading-[1.2] tracking-[-0.02em]">{stat.value}</p>
              {stat.label && <p class="mt-1.5 text-base text-muted">{stat.label}</p>}
            </li>
          ))}
        </ul>
      )
    }

    {
      section.statements && (
        <ul class="mt-8 grid gap-4 sm:grid-cols-2">
          {section.statements.map((statement) => (
            <li class="rounded-2xl border border-border bg-surface p-6">
              <blockquote>
                <Quote aria-hidden="true" class="size-5 text-accent" stroke-width={2.2} />
                <p class="mt-3 text-[17px] leading-[1.55]">{statement}</p>
              </blockquote>
            </li>
          ))}
        </ul>
      )
    }

    {
      section.quote && (
        <blockquote class="mt-10 rounded-2xl border border-border bg-surface p-8">
          <Eyebrow tone="label" size="sm">
            {section.quote.source ?? "From a user interview"}
          </Eyebrow>
          <p class="mt-3 text-2xl leading-[1.4] tracking-[-0.01em]">{section.quote.text}</p>
          <footer class="mt-4 text-[15px] text-label">{section.quote.attribution}</footer>
        </blockquote>
      )
    }

    {
      section.highlights && (
        <ul class="mt-8 grid gap-4 sm:grid-cols-2">
          {section.highlights.map((item) => (
            <li class="rounded-2xl border border-border bg-panel p-6">
              <h3 class="font-semibold">{item.title}</h3>
              <p class="mt-2 text-base text-muted">{item.text}</p>
            </li>
          ))}
        </ul>
      )
    }

    {
      section.profiles && (
        <ul class="mt-6 grid grid-cols-[repeat(auto-fit,minmax(min(240px,100%),1fr))] gap-4">
          {section.profiles.map((profile) => (
            <li class="rounded-2xl border border-border bg-surface p-7">
              {profile.eyebrow && (
                <Eyebrow tone={profile.primary ? "accent" : "label"} size="sm" class="mb-3">
                  {profile.eyebrow}
                </Eyebrow>
              )}
              <h3 class="text-[22px] font-semibold tracking-[-0.01em]">{profile.title}</h3>
              <p class="mt-2 text-base text-muted">{profile.text}</p>
            </li>
          ))}
        </ul>
      )
    }

    {
      section.insights && (
        <ol class="mt-8 flex flex-col gap-px overflow-hidden rounded-2xl border border-border bg-border">
          {section.insights.map((insight, index) => (
            <li class="flex gap-5 bg-panel px-7 py-6">
              <span aria-hidden="true" class="pt-0.5 font-mono text-[15px] text-accent">
                {letters[index]}
              </span>
              <div>
                <h3 class="font-semibold">{insight.title}</h3>
                <p class="mt-1 text-base text-muted">{insight.text}</p>
              </div>
            </li>
          ))}
        </ol>
      )
    }

    {
      comparison && (
        <>
          <h3 class="mt-12 text-xl font-semibold">{comparison.title}</h3>
          <div class="mt-4 overflow-x-auto rounded-2xl border border-border">
            <table class="w-full min-w-[520px] border-collapse text-base">
              <thead>
                <tr class="bg-surface text-left">
                  {comparison.columns.map((column) => (
                    <th scope="col" class="px-5 py-3.5 font-medium text-label">
                      {column}
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {comparison.rows.map((row) => (
                  <tr class={cn("border-t border-border", row.highlight && "bg-highlight")}>
                    <th scope="row" class={cn("px-5 py-3.5 text-left", row.highlight ? "font-semibold" : "font-normal")}>
                      {row.name}
                    </th>
                    <td class={cn("px-5 py-3.5", !row.highlight && "text-muted")}>{row.values[0]}</td>
                    <td class={cn("px-5 py-3.5", row.highlight ? "font-semibold text-accent" : "text-label")}>
                      {row.values[1]}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {comparison.note && <p class="mt-4 text-base text-muted">{comparison.note}</p>}
        </>
      )
    }

    {
      section.featureGroups && (
        <div class="mt-8 grid grid-cols-[repeat(auto-fit,minmax(min(260px,100%),1fr))] gap-8">
          {section.featureGroups.map((group) => (
            <div>
              {group.label && (
                <Eyebrow as="h3" tone="label" size="sm" class="mb-4">
                  {group.label}
                </Eyebrow>
              )}
              <ul class="flex flex-col gap-3 text-base">
                {group.items.map((item) => (
                  <li class="flex gap-3">
                    <Check aria-hidden="true" class="mt-1 size-[18px] flex-none text-accent" stroke-width={2.2} />
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      )
    }

    {section.outro && <p class="mt-8 text-muted">{section.outro}</p>}
  </div>
</section>

{section.figures && <FigureGrid figures={section.figures} />}
