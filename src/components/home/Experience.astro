---
import { FileText } from "@lucide/astro";
import { site } from "@/content/site";
import { education, experience } from "@/content/resume";
import SectionHeading from "./SectionHeading.astro";
---

<section id="experience" aria-labelledby="experience-title" class="pt-[140px]">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <SectionHeading id="experience-title" eyebrow="Experience" title="Where I've worked" />
    <a
      href={site.resumePath}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex min-h-11 items-center gap-2 rounded-full border border-border-strong px-5 text-[15px] font-medium text-foreground transition-colors hover:border-label hover:bg-raised"
    >
      <FileText aria-hidden="true" class="size-4" />
      Full resume (PDF)
    </a>
  </div>

  <ol class="mt-10 border-t border-border">
    {
      experience.map((item) => (
        <li class="flex flex-wrap gap-x-12 gap-y-2 border-b border-border py-7">
          <p class="shrink grow basis-[180px] pt-[3px] font-mono text-sm text-label">{item.period}</p>
          <div class="min-w-0 shrink grow-[999] basis-[520px]">
            <h3 class="text-xl font-semibold">{item.role}</h3>
            <p class="text-base text-muted">{item.organization}</p>
            <p class="mt-2 text-base text-muted">{item.description}</p>
          </div>
        </li>
      ))
    }
  </ol>

  <h3 class="mt-16 font-mono text-[13px] font-medium uppercase tracking-[0.08em] text-label">Education</h3>
  <ul class="mt-4 grid grid-cols-[repeat(auto-fit,minmax(min(260px,100%),1fr))] gap-4">
    {
      education.map((item) => (
        <li class="rounded-2xl border border-border bg-surface p-6">
          <p class="font-semibold">{item.school}</p>
          <p class="text-base text-muted">{item.credential}</p>
          <p class="mt-2 font-mono text-[13px] text-label">{item.date}</p>
        </li>
      ))
    }
  </ul>
</section>
