---
import { Image } from "astro:assets";
import type { Project } from "@/content/projects";
import { cardSurface, stretchedLink } from "@/components/common/styles";
import ExternalProjectLink from "@/components/common/ExternalProjectLink.astro";
import { cn } from "@/lib/utils";
import ProjectTags from "./ProjectTags.astro";

// A cover keeps its 4:3 shape so its device mockups are not cropped; screenshots fill a fixed height.
const { project } = Astro.props as { project: Project };
---

<article
  class={cn(
    cardSurface,
    "group relative flex w-full flex-col overflow-hidden rounded-[20px] text-foreground transition-colors focus-within:border-border-strong hover:border-border-strong",
  )}
>
  <div class={cn("overflow-hidden bg-raised", project.cardImage.frame === "plain" ? "aspect-[4/3]" : "h-60")}>
    <Image
      src={project.cardImage.src}
      alt={project.cardImage.alt}
      widths={[480, 800, 1200]}
      sizes="(min-width: 1120px) 560px, (min-width: 640px) 50vw, 100vw"
      loading="lazy"
      decoding="async"
      class="block h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.02]"
    />
  </div>
  <div class="flex flex-col gap-2.5 p-7">
    <ProjectTags project={project} />
    <h3 class="text-2xl font-semibold tracking-[-0.02em]">
      <a href={`/case-study/${project.id}`} class={stretchedLink("after:rounded-[20px]")}>
        {project.title}
      </a>
    </h3>
    <p class="text-base text-muted">{project.summary}</p>
    <p class="font-mono text-[13px] text-label">{project.stack.join(" · ")}</p>
    {project.link && <ExternalProjectLink link={project.link} class="self-start" />}
  </div>
</article>
